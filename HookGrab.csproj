<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HookGrab</RootNamespace>
    <AssemblyName>HookGrab</AssemblyName>

    <!-- Derlenen dll'i doğrudan yayın klasörüne kopyalar -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- CounterStrikeSharp API paketi (Swiftly / CS# resmi NuGet feed'i gerektirir,
         bkz. README.md "Kurulum" bölümü) -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.*" />
  </ItemGroup>

</Project>
